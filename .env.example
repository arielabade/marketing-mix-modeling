# Copy to .env (never commit .env). Read by the Makefile and by mmm.settings.

# mysql | bigquery | parquet
MMM_DATA_SOURCE=mysql
# Local ecommerce MySQL (docker compose in ../ecommerce). Cloud SQL: same URL shape,
# host = Cloud SQL Auth Proxy (127.0.0.1) or the instance's private IP.
MMM_DATABASE_URL=mysql+pymysql://analista:analista123@127.0.0.1:3336/tecidos_marts
# BigQuery (production option, see docs/DEPLOY.md)
# MMM_BQ_PROJECT=my-gcp-project
# MMM_BQ_DATASET=tecidos_marts
# Parquet snapshot (CI default is tests/fixtures/mart_small)
# MMM_PARQUET_DIR=tests/fixtures/mart_small

# default | small
MMM_PROFILE=default
MMM_REGISTRY_PATH=models/registry
MMM_REPORTS_PATH=reports

# Only mmm.validation reads this (after fitting). Modelling code is blocked from it.
MMM_GROUND_TRUTH_DIR=../ecommerce/data/ground_truth
